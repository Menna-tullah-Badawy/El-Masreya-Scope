# انسخ الملف ده لـ .env وعدّل القيم
# للتشغيل المحلي (مش داخل devcontainer) استخدم: @127.0.0.1:5432

DATABASE_URL=postgresql+psycopg2://scope:scope123@db:5432/scopedb
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Stripe (اتركه فارغاً ليعمل النظام في وضع المحاكاة/Demo)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=egp

# بيانات الشركة
COMPANY_NAME_AR=سكوب - الشركة المصرية
COMPANY_NAME_EN=SCOPE Egypt
COMPANY_PHONE=01113138839
COMPANY_WHATSAPP=201113138839
COMPANY_EMAIL=info@scope-eg.com
COMPANY_ADDRESS_AR=الجيزة، جمهورية مصر العربية
COMPANY_ADDRESS_EN=Giza, Egypt
CURRENCY_AR=جنيه
CURRENCY_EN=EGP

CORS_ORIGINS=*
